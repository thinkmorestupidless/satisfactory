<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%d{HH:mm:ss.SSS} %-5level %logger{20} - %msg%n</pattern></encoder>
  </appender>
  <appender name="CAPTURE" class="satisfactory.api.CapturingAppender" />
  <logger name="org.apache.pekko" level="WARN" />
  <logger name="com.thinkmorestupidless.ankka" level="WARN" />
  <logger name="org.testcontainers" level="WARN" />
  <logger name="com.zaxxer.hikari" level="WARN" />
  <logger name="io.r2dbc" level="WARN" />
  <logger name="ai.timefold" level="WARN" />
  <root level="INFO">
    <appender-ref ref="STDOUT" />
    <appender-ref ref="CAPTURE" />
  </root>
</configuration>
